---
import Layout from "../../layouts/Layout.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import { Icon } from "astro-icon/components";
import { url } from "../../utils/url";
import {
  steps,
  keyFacts,
  officialInfoUrl,
  communityGroupUrl,
  helpPhone,
  stepsPdf,
} from "../../data/ivf-national-program";
---

<Layout
  active="ivf"
  sub="national-program"
  title="GrowKids Future — 2026-os Országos Lombikprogram (FIV)"
  description="A 2026-os romániai Országos Lombikprogram (FIV) feltételei és a jelentkezés lépései magyarul — jelentkezés 2026 augusztusától, határidő november 15."
>
  <!-- ============== Hero ============== -->
  <section class="px-5 pt-10 pb-14 md:px-10 md:pt-14 md:pb-16 lg:px-20">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="label-sm bg-primary-fixed/60 text-on-primary-fixed inline-flex items-center gap-2 rounded-full px-4 py-2 uppercase"
      >
        <Icon name="ph:megaphone-duotone" class="size-4" aria-hidden="true" />
        Jelentkezés 2026 augusztusától
      </p>

      <h1 class="headline-lg-mobile md:headline-lg mt-6">
        <span class="text-on-surface block">2026-os Országos</span>
        <span class="text-primary mt-1 block">Lombikprogram (FIV)</span>
      </h1>

      <p class="body-md text-on-surface-variant mt-6">
        Ha szeretnének jelentkezni a programba, időben foglaljanak időpontot
        <span class="text-primary">meddőségi szakorvosi konzultációra</span>. Az orvosi kivizsgálást
        követően, amennyiben megfelelnek a jogosultsági feltételeknek, megkapják a programba történő
        jelentkezéshez szükséges igazolást.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="#lepesek"
          class="label-sm bg-primary text-on-primary hover:bg-primary-container hover:text-on-primary-container inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 uppercase transition"
        >
          <Icon name="ph:list-numbers" class="size-5" aria-hidden="true" />
          A jelentkezés lépései
        </a>
        <a
          href={url(stepsPdf)}
          rel="noopener noreferrer"
          target="_blank"
          class="label-sm border-primary text-primary hover:bg-primary-fixed/40 inline-flex items-center justify-center gap-2 rounded-full border px-6 py-3 uppercase transition"
        >
          <Icon name="ph:file-pdf" class="size-5" aria-hidden="true" />
          Letöltés PDF-ben
        </a>
      </div>
    </div>
  </section>

  <!-- ============== Help + official info ============== -->
  <section class="bg-surface-container-low px-5 py-16 md:px-10 md:py-20 lg:px-20">
    <div class="mx-auto" style="max-width: var(--container-max);">
      <div class="grid gap-6 lg:grid-cols-2">
        <!-- GrowKids help -->
        <div class="bg-surface-container-lowest shadow-ambient rounded-xl p-8 md:p-10">
          <div
            class="bg-primary-fixed/50 flex size-14 items-center justify-center rounded-full"
            aria-hidden="true"
          >
            <Icon name="ph:hand-heart-duotone" class="text-primary size-7" />
          </div>
          <h2 class="title-lg text-on-surface mt-6">Segítünk a beiratkozásban</h2>
          <p class="body-md text-on-surface-variant mt-3">
            Amennyiben a programba való beiratkozáshoz bárkinek szüksége van segítségre, keressék
            bátran a GrowKids csapat tagjait is.
          </p>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a
              href={helpPhone.href}
              class="label-sm bg-primary text-on-primary hover:bg-primary-container hover:text-on-primary-container inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 transition"
            >
              <Icon name="ph:phone-fill" class="size-5" aria-hidden="true" />
              {helpPhone.display}
            </a>
            <a
              href={communityGroupUrl}
              rel="noopener noreferrer"
              target="_blank"
              class="label-sm border-primary text-primary hover:bg-primary-fixed/40 inline-flex items-center justify-center gap-2 rounded-full border px-6 py-3 uppercase transition"
            >
              <Icon name="ph:facebook-logo-fill" class="size-5" aria-hidden="true" />
              Közösségi csoport
            </a>
          </div>
        </div>

        <!-- Official documents -->
        <div class="bg-surface-container-lowest shadow-ambient rounded-xl p-8 md:p-10">
          <div
            class="bg-primary-fixed/50 flex size-14 items-center justify-center rounded-full"
            aria-hidden="true"
          >
            <Icon name="ph:files-duotone" class="text-primary size-7" />
          </div>
          <h2 class="title-lg text-on-surface mt-6">Információk és dokumentumok</h2>
          <p class="body-md text-on-surface-variant mt-3">
            A hivatalos feltételek, mellékletek és nyomtatványok a Munkaügyi Minisztérium oldalán
            érhetők el. A jelentkezés lépéseit magyar nyelven is összefoglaltuk — ez letölthető
            dokumentumként is elérhető.
          </p>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a
              href={officialInfoUrl}
              rel="noopener noreferrer"
              target="_blank"
              class="label-sm bg-primary text-on-primary hover:bg-primary-container hover:text-on-primary-container inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 uppercase transition"
            >
              <Icon name="ph:arrow-square-out" class="size-5" aria-hidden="true" />
              mmuncii.gov.ro
            </a>
            <a
              href={url(stepsPdf)}
              rel="noopener noreferrer"
              target="_blank"
              class="label-sm border-primary text-primary hover:bg-primary-fixed/40 inline-flex items-center justify-center gap-2 rounded-full border px-6 py-3 uppercase transition"
            >
              <Icon name="ph:file-pdf" class="size-5" aria-hidden="true" />
              Lépések PDF
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== Key facts ============== -->
  <section class="px-5 py-16 md:px-10 md:py-20 lg:px-20">
    <div class="mx-auto" style="max-width: var(--container-max);">
      <SectionTitle
        title="A program dióhéjban"
        subtitle="A legfontosabb számok, amelyeket érdemes szem előtt tartani a jelentkezés előtt."
      />

      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          keyFacts.map((f) => (
            <li class="bg-surface-container-lowest shadow-ambient flex flex-col items-center rounded-lg p-6 text-center">
              <div
                class="bg-primary-fixed/50 flex size-16 items-center justify-center rounded-full"
                aria-hidden="true"
              >
                <Icon name={f.icon} class="text-primary size-8" />
              </div>
              <p class="display-md text-primary mt-5">{f.value}</p>
              <p class="body-md text-on-surface-variant mt-2">{f.label}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============== Steps ============== -->
  <section id="lepesek" class="bg-surface-container-low px-5 py-16 md:px-10 md:py-20 lg:px-20">
    <div class="mx-auto" style="max-width: var(--container-max);">
      <SectionTitle
        title="A jelentkezés lépései"
        subtitle="Kilenc lépés a jogosultság ellenőrzésétől a kezelés megkezdéséig."
      />

      <ol class="mx-auto mt-12 max-w-3xl space-y-6">
        {
          steps.map((step, i) => (
            <li class="bg-surface-container-lowest shadow-ambient rounded-lg p-6 md:p-8">
              <div class="flex items-start gap-4">
                <div
                  class="bg-primary-fixed/50 flex size-12 flex-none items-center justify-center rounded-full"
                  aria-hidden="true"
                >
                  <Icon name={step.icon} class="text-primary size-6" />
                </div>
                <div class="min-w-0 flex-1">
                  <p class="label-sm text-primary uppercase">{i + 1}. lépés</p>
                  <h3 class="title-sm text-on-surface mt-1">{step.title}</h3>

                  {step.intro && <p class="body-md text-on-surface-variant mt-4">{step.intro}</p>}

                  {step.groups?.map((group) => (
                    <div class="mt-4">
                      {group.intro && (
                        <p class="body-md text-on-surface font-medium">{group.intro}</p>
                      )}
                      <ul class="mt-2 space-y-2">
                        {group.bullets.map((bullet) => (
                          <li class="body-md text-on-surface-variant flex gap-3">
                            <Icon
                              name="ph:leaf-fill"
                              class="text-primary mt-2 size-3 flex-none"
                              aria-hidden="true"
                            />
                            <span>{bullet}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}

                  {step.note && (
                    <p class="body-md text-on-surface bg-primary-fixed/40 mt-5 rounded px-4 py-3">
                      {step.note}
                    </p>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="mt-12 text-center">
        <a
          href={url(stepsPdf)}
          rel="noopener noreferrer"
          target="_blank"
          class="label-sm bg-primary text-on-primary hover:bg-primary-container hover:text-on-primary-container inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 uppercase transition"
        >
          <Icon name="ph:file-pdf" class="size-5" aria-hidden="true" />
          A lépések letöltése PDF-ben
        </a>
      </div>
    </div>
  </section>

  <!-- ============== Closing CTA ============== -->
  <section class="px-5 py-16 md:px-10 md:py-20 lg:px-20">
    <div class="mx-auto" style="max-width: var(--container-max);">
      <div
        class="bg-primary-fixed/40 mx-auto max-w-3xl rounded-xl px-6 py-10 text-center md:px-12 md:py-12"
      >
        <h2 class="title-lg text-on-surface">Kérdésed van a jelentkezéssel kapcsolatban?</h2>
        <p class="body-md text-on-surface-variant mt-4">
          Keresd a GrowKids csapatát a
          <a href={helpPhone.href} class="text-primary underline">{helpPhone.display}</a>
          telefonszámon, vagy lépj be a közösségi csoportba. A Kezdeteket Támogatjuk Lombikprogramról
          <a href={url("/ivf-program/supporting-beginnings")} class="text-primary underline"
            >itt olvashatsz</a
          >.
        </p>
        <a
          href={communityGroupUrl}
          rel="noopener noreferrer"
          target="_blank"
          class="bg-primary text-on-primary hover:bg-primary-container hover:text-on-primary-container mt-8 inline-flex items-center gap-2 rounded-full px-6 py-3 transition"
        >
          <Icon name="ph:facebook-logo-fill" class="size-5" aria-hidden="true" />
          <span class="label-sm uppercase">Csatlakozom a közösséghez</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
