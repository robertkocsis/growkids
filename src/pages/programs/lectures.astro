---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Lecture {
  title: string;
  summary: string;
  date: string;
  location: string[];
  audience: string;
  // Add optimized images from src/assets/lectures/ here once available.
  // An empty array renders placeholder tiles + a "coming soon" note.
  images: { src: ImageMetadata; alt: string }[];
}

// ⚠️ PLACEHOLDER CONTENT — Zsici will supply the real lecture texts, dates,
// locations and photos. The dates/addresses below are from the mockup and are
// NOT correct. New lectures go at the TOP of this array (newest first).
const lectures: Lecture[] = [
  {
    title: "TSMT előadás szülőknek",
    summary: "Hogyan segíthetjük gyermekünk fejlődését otthon a TSMT eszközeivel?",
    date: "2025. június 26. (csütörtök) 17:00",
    location: ["Embryos Klinika előadóterme", "1052 Budapest, Petőfi Sándor utca 11."],
    audience: "szülők, érdeklődők",
    images: [],
  },
  {
    title: "TSMT előadás pedagógusoknak",
    summary:
      "A TSMT módszer szerepe az óvodai és iskolai mindennapokban – gyakorlati megközelítésben.",
    date: "2025. június 12. (csütörtök) 17:00",
    location: ["Embryos Klinika előadóterme", "1052 Budapest, Petőfi Sándor utca 11."],
    audience: "pedagógusok, szakemberek",
    images: [],
  },
];
---

<Layout
  active="programs"
  programsSub="lectures"
  title="GrowKids Future — Előadások"
  description="Szakmai előadásaink hasznos tudást és gyakorlati segítséget nyújtanak pedagógusoknak és szülőknek a gyermekek fejlődésének támogatásához."
>
  <!-- ============== Hero ============== -->
  <section class="px-5 pt-10 pb-12 md:px-10 md:pt-14 md:pb-16 lg:px-20">
    <div class="mx-auto" style="max-width: var(--container-max);">
      <p class="label-sm text-primary uppercase">Programjaink</p>
      <h1 class="headline-lg-mobile md:headline-lg text-on-surface mt-3">Előadások</h1>
      <p class="body-md text-on-surface-variant mt-5 max-w-2xl">
        Szakmai előadásaink célja, hogy hasznos tudást és gyakorlati segítséget nyújtsunk
        pedagógusoknak és szülőknek a gyermekek fejlődésének támogatásához.
      </p>
    </div>
  </section>

  <!-- ============== Lectures (stacked, newest first) ============== -->
  <section class="px-5 pb-20 md:px-10 lg:px-20">
    <div class="mx-auto flex flex-col gap-8" style="max-width: var(--container-max);">
      {
        lectures.map((lecture) => (
          <article class="bg-surface-container-lowest shadow-ambient rounded-lg p-6 md:p-10">
            <div class="flex items-start gap-4">
              <div
                class="bg-primary-fixed/50 flex size-14 flex-none items-center justify-center rounded-full"
                aria-hidden="true"
              >
                <Icon name="ph:chalkboard-teacher-duotone" class="text-primary size-7" />
              </div>
              <div>
                <h2 class="title-sm md:title-lg text-on-surface">{lecture.title}</h2>
                <p class="body-md text-on-surface-variant mt-2">{lecture.summary}</p>
              </div>
            </div>

            <dl class="border-outline-variant mt-6 grid gap-4 border-t pt-6 sm:grid-cols-3">
              <div class="flex items-start gap-3">
                <Icon name="ph:calendar-blank" class="text-primary mt-0.5 size-5 flex-none" />
                <div>
                  <dt class="label-sm text-on-surface-variant uppercase">Időpont</dt>
                  <dd class="body-md text-on-surface mt-1">{lecture.date}</dd>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <Icon name="ph:map-pin" class="text-primary mt-0.5 size-5 flex-none" />
                <div>
                  <dt class="label-sm text-on-surface-variant uppercase">Helyszín</dt>
                  <dd class="body-md text-on-surface mt-1">
                    {lecture.location.map((line) => (
                      <span class="block">{line}</span>
                    ))}
                  </dd>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <Icon name="ph:user" class="text-primary mt-0.5 size-5 flex-none" />
                <div>
                  <dt class="label-sm text-on-surface-variant uppercase">Célcsoport</dt>
                  <dd class="body-md text-on-surface mt-1">{lecture.audience}</dd>
                </div>
              </div>
            </dl>

            <div class="mt-8">
              <div class="text-on-surface-variant flex items-center gap-2">
                <Icon name="ph:images-duotone" class="text-primary size-5" />
                <span class="label-sm uppercase">Képgaléria</span>
              </div>

              {lecture.images.length > 0 ? (
                <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
                  {lecture.images.map((img) => (
                    <li>
                      <button
                        type="button"
                        class="lightbox-trigger group focus-visible:ring-primary block w-full overflow-hidden rounded focus-visible:ring-2 focus-visible:outline-none"
                        data-full={img.src.src}
                        data-alt={img.alt}
                      >
                        <Image
                          src={img.src}
                          alt={img.alt}
                          widths={[240, 360, 480]}
                          sizes="(max-width: 640px) 45vw, 360px"
                          class="aspect-video w-full object-cover transition group-hover:scale-105"
                        />
                      </button>
                    </li>
                  ))}
                </ul>
              ) : (
                <>
                  <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3" aria-hidden="true">
                    {[0, 1, 2].map(() => (
                      <li class="bg-surface-container flex aspect-video items-center justify-center rounded">
                        <Icon name="ph:image-duotone" class="text-on-surface-variant/40 size-8" />
                      </li>
                    ))}
                  </ul>
                  <p class="body-md text-on-surface-variant/70 mt-3 italic">
                    A képek hamarosan elérhetők lesznek.
                  </p>
                </>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Lightbox overlay — activates for lectures that have real images -->
  <div
    id="lightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Kép nagyítva"
  >
    <button
      type="button"
      id="lightbox-close"
      class="absolute top-5 right-5 flex size-11 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20"
      aria-label="Bezárás"
    >
      <Icon name="ph:x" class="size-6" />
    </button>
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-h-[90vh] max-w-full rounded-lg object-contain"
    />
  </div>

  <script>
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
    const closeBtn = document.getElementById("lightbox-close");

    const open = (src: string, alt: string) => {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
    };

    const close = () => {
      if (!lightbox || !lightboxImg) return;
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      lightboxImg.src = "";
      document.body.style.overflow = "";
    };

    document.querySelectorAll<HTMLButtonElement>(".lightbox-trigger").forEach((btn) => {
      btn.addEventListener("click", () => open(btn.dataset.full ?? "", btn.dataset.alt ?? ""));
    });

    closeBtn?.addEventListener("click", close);
    lightbox?.addEventListener("click", (e) => {
      if (e.target === lightbox) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  </script>
</Layout>
