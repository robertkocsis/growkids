---
import Layout from "../../layouts/Layout.astro";
import GalleryLightbox from "../../components/GalleryLightbox.astro";
import { Icon } from "astro-icon/components";
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Lecture {
  /**
   * Stable kebab-case id. Photos for this event live in
   * `src/assets/lectures/<id>/` — drop image files there and they are picked up
   * automatically (sorted by filename). No code change needed to add photos.
   */
  id: string;
  title: string;
  summary: string;
  /** Human-readable Hungarian date shown on the card. */
  date: string;
  /** Machine date (ISO 8601) — drives newest-first sort, the past/upcoming
   *  badge, and the Event structured data. */
  dateISO: string;
  location: string[];
  audience: string;
  /** Optional presenter / speaker. */
  presenter?: string;
}

// Order doesn't matter here — the list is sorted by dateISO (newest first) below.
const lectures: Lecture[] = [
  {
    id: "tsmt-szuloknek-kraszna-2025",
    title: "TSMT előadás szülőknek",
    summary:
      "Minden, amit a mozgásról és az idegrendszer fejlődéséről tudni érdemes. Mikor áll készen valóban a gyermek az iskolára?",
    date: "2026. május 22. (péntek) 18:00",
    dateISO: "2026-05-22T18:00:00+03:00",
    location: ["Cserey-Goga Technológiai Líceum díszterme", "Kraszna, Szilágy megye"],
    audience: "szülők, érdeklődők",
    presenter: "Simpf-Domokos Orsolya",
  },
  {
    id: "tsmt-pedagogusoknak-kraszna-2025",
    title: "TSMT előadás pedagógusoknak",
    summary:
      "Hogyan segítheti a mozgásterápia – a szenzoros integráció, és ezen belül a TSMT terápia – a gyerekek harmonikus fejlődését, az iskolai beválást és a békés hétköznapokat?",
    date: "2026. április 17. (péntek) 17:00",
    dateISO: "2026-04-17T17:00:00+03:00",
    location: ["Cserey-Goga Technológiai Líceum díszterme", "Kraszna, Szilágy megye"],
    audience: "pedagógusok, szakemberek",
    presenter: "Simpf-Domokos Orsolya",
  },
].sort((a, b) => b.dateISO.localeCompare(a.dateISO));

// Build-time "now" — the past/upcoming badge reflects the last deploy.
const now = new Date();

// ── Auto-collect each event's photos from src/assets/lectures/<id>/ ──────────
// Drop files into the folder named after the lecture id; they appear here,
// sorted by filename, fully optimized by astro:assets.
const galleryFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/lectures/*/*.{jpeg,jpg,png,webp,avif}",
  { eager: true },
);

const galleries: Record<string, ImageMetadata[]> = {};
for (const path of Object.keys(galleryFiles).sort()) {
  const id = path.match(/lectures\/([^/]+)\//)?.[1];
  if (!id) continue;
  (galleries[id] ??= []).push(galleryFiles[path].default);
}

// Pre-render WebP versions for the lightbox, keyed by id: a large one for the
// main view and a tiny one for the thumbnail strip (so opening a gallery doesn't
// download full-resolution images just to render 80px thumbs).
const titleById = Object.fromEntries(lectures.map((l) => [l.id, l.title]));
const galleryData: Record<string, { src: string; thumb: string; alt: string }[]> = {};
for (const [id, imgs] of Object.entries(galleries)) {
  galleryData[id] = await Promise.all(
    imgs.map(async (img, i) => ({
      src: (await getImage({ src: img, width: 1600, format: "webp" })).src,
      thumb: (await getImage({ src: img, width: 200, format: "webp" })).src,
      alt: `${titleById[id] ?? "Előadás"} – ${i + 1}. kép`,
    })),
  );
}

// Event structured data (JSON-LD) — rich results once the prod crawl is enabled.
const eventsJsonLd = lectures.map((l) => ({
  "@context": "https://schema.org",
  "@type": "Event",
  name: l.title,
  description: l.summary,
  startDate: l.dateISO,
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  location: {
    "@type": "Place",
    name: l.location[0],
    address: l.location.join(", "),
  },
  ...(l.presenter ? { performer: { "@type": "Person", name: l.presenter } } : {}),
  organizer: {
    "@type": "Organization",
    name: "GrowKids Future",
    url: "https://growkidsfuture.ro",
  },
}));
---

<Layout
  active="programs"
  programsSub="lectures"
  title="GrowKids Future — Előadások"
  description="Szakmai előadásaink hasznos tudást és gyakorlati segítséget nyújtanak pedagógusoknak és szülőknek a gyermekek fejlődésének támogatásához."
>
  <script type="application/ld+json" set:html={JSON.stringify(eventsJsonLd)} />

  <!-- ============== Hero ============== -->
  <section class="px-5 pt-10 pb-12 md:px-10 md:pt-14 md:pb-16 lg:px-20">
    <div class="mx-auto" style="max-width: var(--container-max);">
      <p class="label-sm text-primary uppercase">Programjaink</p>
      <h1 class="headline-lg-mobile md:headline-lg text-on-surface mt-3">Előadások</h1>
    </div>
  </section>

  <!-- ============== Lectures (stacked, newest first) ============== -->
  <section class="px-5 pb-20 md:px-10 lg:px-20">
    <div class="mx-auto flex flex-col gap-8" style="max-width: var(--container-max);">
      {
        lectures.map((lecture) => {
          const images = galleries[lecture.id] ?? [];
          const thumbs = images.slice(0, 3);
          const remaining = images.length - thumbs.length;
          const isPast = new Date(lecture.dateISO) < now;
          return (
            <article class="bg-surface-container-lowest shadow-ambient rounded-lg p-6 md:p-10">
              <div class="flex items-start gap-4">
                <div
                  class="bg-primary-fixed/50 flex size-14 flex-none items-center justify-center rounded-full"
                  aria-hidden="true"
                >
                  <Icon name="ph:projector-screen-duotone" class="text-primary size-7" />
                </div>
                <div>
                  <span
                    class:list={[
                      "label-sm inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 uppercase",
                      isPast
                        ? "bg-surface-container-high text-on-surface-variant"
                        : "bg-primary-fixed text-on-primary-fixed-variant",
                    ]}
                  >
                    <Icon name={isPast ? "ph:check-circle" : "ph:calendar-dot"} class="size-4" />
                    {isPast ? "Lezajlott" : "Közelgő"}
                  </span>
                  <h2 class="title-sm md:title-lg text-on-surface mt-2">{lecture.title}</h2>
                  <p class="body-md text-on-surface-variant mt-2">{lecture.summary}</p>
                </div>
              </div>

              <dl class="border-outline-variant mt-6 grid gap-4 border-t pt-6 sm:grid-cols-2 lg:grid-cols-4">
                <div class="flex items-start gap-3">
                  <Icon name="ph:calendar-blank" class="text-primary mt-0.5 size-5 flex-none" />
                  <div>
                    <dt class="label-sm text-on-surface-variant uppercase">Időpont</dt>
                    <dd class="body-md text-on-surface mt-1">{lecture.date}</dd>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Icon name="ph:map-pin" class="text-primary mt-0.5 size-5 flex-none" />
                  <div>
                    <dt class="label-sm text-on-surface-variant uppercase">Helyszín</dt>
                    <dd class="body-md text-on-surface mt-1">
                      {lecture.location.map((line) => (
                        <span class="block">{line}</span>
                      ))}
                    </dd>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Icon name="ph:user" class="text-primary mt-0.5 size-5 flex-none" />
                  <div>
                    <dt class="label-sm text-on-surface-variant uppercase">Célcsoport</dt>
                    <dd class="body-md text-on-surface mt-1">{lecture.audience}</dd>
                  </div>
                </div>
                {lecture.presenter && (
                  <div class="flex items-start gap-3">
                    <Icon name="ph:microphone-stage" class="text-primary mt-0.5 size-5 flex-none" />
                    <div>
                      <dt class="label-sm text-on-surface-variant uppercase">Előadó</dt>
                      <dd class="body-md text-on-surface mt-1">{lecture.presenter}</dd>
                    </div>
                  </div>
                )}
              </dl>

              <div class="mt-8">
                <div class="text-on-surface-variant flex items-center gap-2">
                  <Icon name="ph:images-duotone" class="text-primary size-5" />
                  <span class="label-sm uppercase">Képgaléria</span>
                </div>

                {images.length > 0 ? (
                  <>
                    <ul class="mt-4 grid grid-cols-3 gap-3">
                      {thumbs.map((img, i) => (
                        <li>
                          <button
                            type="button"
                            class="gallery-trigger group focus-visible:ring-primary relative block w-full overflow-hidden rounded focus-visible:ring-2 focus-visible:outline-none"
                            data-gallery={lecture.id}
                            data-index={i}
                            aria-label={`${lecture.title} – galéria megnyitása`}
                          >
                            <Image
                              src={img}
                              alt={`${lecture.title} – ${i + 1}. kép`}
                              widths={[240, 360, 480]}
                              sizes="(max-width: 640px) 30vw, 360px"
                              class="aspect-video w-full object-cover transition group-hover:scale-105"
                            />
                            {i === 2 && remaining > 0 && (
                              <span class="absolute inset-0 flex items-center justify-center bg-black/55 transition group-hover:bg-black/65">
                                <span class="title-sm text-white">+{remaining}</span>
                              </span>
                            )}
                          </button>
                        </li>
                      ))}
                    </ul>
                    <button
                      type="button"
                      class="gallery-trigger text-primary hover:text-primary-container mt-4 inline-flex items-center gap-2 rounded-full"
                      data-gallery={lecture.id}
                      data-index="0"
                    >
                      <Icon name="ph:images" class="size-5" />
                      <span class="label-sm uppercase">
                        Galéria megnyitása ({images.length} kép)
                      </span>
                    </button>
                  </>
                ) : (
                  <>
                    <ul class="mt-4 grid grid-cols-3 gap-3" aria-hidden="true">
                      {[0, 1, 2].map(() => (
                        <li class="bg-surface-container flex aspect-video items-center justify-center rounded">
                          <Icon name="ph:image-duotone" class="text-on-surface-variant/40 size-8" />
                        </li>
                      ))}
                    </ul>
                    <p class="body-md text-on-surface-variant/70 mt-3 italic">
                      A képek hamarosan elérhetők lesznek.
                    </p>
                  </>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- Gallery data for the lightbox (id -> [{ src, alt }]) -->
  <script type="application/json" id="galleries-data" set:html={JSON.stringify(galleryData)} />

  <GalleryLightbox />
</Layout>
