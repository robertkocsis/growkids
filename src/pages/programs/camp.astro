---
import Layout from "../../layouts/Layout.astro";
import GalleryLightbox from "../../components/GalleryLightbox.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import { Icon } from "astro-icon/components";
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import groupPhoto from "../../assets/camp/tabor-2026-csoportkep.jpeg";

// Pre-render a large (full view) and a tiny (thumbnail strip) WebP for every
// lightbox image, per the GalleryLightbox contract.
const buildEntry = async (img: ImageMetadata, alt: string) => ({
  src: (await getImage({ src: img, width: 1600, format: "webp" })).src,
  thumb: (await getImage({ src: img, width: 200, format: "webp" })).src,
  alt,
});

// The closing group photo is a standalone image, so it gets its own gallery
// (GalleryLightbox auto-hides the nav chrome for single-image galleries).
const galleryData: Record<string, { src: string; thumb: string; alt: string }[]> = {
  "camp-group-2026": [
    await buildEntry(groupPhoto, "Kreatív Nyári Tábor 2026 – közös csoportkép a kézlenyomat-fával"),
  ],
};

// ── Thematic days ───────────────────────────────────────────────────────────
// Photos live in src/assets/camp/days/<id>/ and are auto-collected (sorted by
// filename) — drop files into the matching folder to add more.
interface CampDay {
  id: string;
  /** "1. nap", "Zárónap", … — the badge on the card. */
  badge: string;
  title: string;
  date: string;
  icon: string;
}

const days: CampDay[] = [
  {
    id: "01-nepi-kincsek",
    badge: "1. nap",
    title: "Népi kincsek",
    date: "2026. augusztus 10.",
    icon: "ph:flower-lotus-duotone",
  },
  {
    id: "02-epits-es-alkoss",
    badge: "2. nap",
    title: "Építs és alkoss",
    date: "2026. augusztus 11.",
    icon: "ph:hammer-duotone",
  },
  {
    id: "03-mozgas-es-kaland",
    badge: "3. nap",
    title: "Mozgás és kaland",
    date: "2026. augusztus 12.",
    icon: "ph:person-simple-run-duotone",
  },
  {
    id: "04-fa-termeszet-elet",
    badge: "4. nap",
    title: "Fa. Természet. Élet.",
    date: "2026. augusztus 13.",
    icon: "ph:tree-duotone",
  },
  {
    id: "05-mesevilag",
    badge: "5. nap",
    title: "Mesevilág",
    date: "2026. augusztus 14.",
    icon: "ph:book-open-text-duotone",
  },
  {
    id: "06-zaronap",
    badge: "Zárónap",
    title: "Közös ünneplés",
    date: "2026. augusztus 14.",
    icon: "ph:confetti-duotone",
  },
];

const dayFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/camp/days/*/*.{jpeg,jpg,png,webp,avif}",
  { eager: true }
);

const dayGalleries: Record<string, ImageMetadata[]> = {};
for (const path of Object.keys(dayFiles).sort()) {
  const id = path.match(/days\/([^/]+)\//)?.[1];
  if (!id) continue;
  (dayGalleries[id] ??= []).push(dayFiles[path].default);
}

// Add each day's photos to the shared lightbox data.
for (const day of days) {
  galleryData[day.id] = await Promise.all(
    (dayGalleries[day.id] ?? []).map((img, i) => buildEntry(img, `${day.title} – ${i + 1}. kép`))
  );
}

const photoCount = days.reduce((sum, d) => sum + (dayGalleries[d.id]?.length ?? 0), 0);

// Event structured data (JSON-LD) — the 2026 camp as a past event.
const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: "Kreatív Nyári Tábor Krasznán",
  description:
    "Kreatív Nyári Tábor 2026 Krasznán 6–9 éves gyermekeknek — öt tematikus nap képgalériája.",
  startDate: "2026-08-10T08:00:00+03:00",
  endDate: "2026-08-14T16:00:00+03:00",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  location: {
    "@type": "Place",
    name: "Krasznai Falumúzeum",
    address: "Kraszna, Szilágy megye",
  },
  image: [galleryData["camp-group-2026"][0].src],
  organizer: {
    "@type": "Organization",
    name: "GrowKids Future",
    url: "https://growkidsfuture.ro",
  },
};
---

<Layout
  active="programs"
  sub="camp"
  title="GrowKids Future — Kreatív Nyári Tábor 2026"
  description="Képgaléria a 2026-os Kreatív Nyári Táborról Krasznán: tematikus napok, kézművesség, népi hagyományok, mozgás és természetközeli élmények."
>
  <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />

  <!-- ============== Hero: title + closing group photo ============== -->
  <section class="px-5 pt-10 pb-12 md:px-10 md:pt-14 md:pb-16 lg:px-20">
    <div class="mx-auto" style="max-width: var(--container-max);">
      <p class="label-sm text-primary uppercase">Programjaink · Tábor 2026</p>
      <h1 class="headline-lg-mobile md:headline-lg text-on-surface mt-3">
        Kreatív Nyári Tábor Krasznán
      </h1>

      <ul class="mt-6 flex flex-wrap gap-3">
        <li
          class="bg-surface-container-lowest shadow-ambient flex items-center gap-2 rounded-full px-4 py-2"
        >
          <Icon name="ph:calendar-blank" class="text-primary size-5" />
          <span class="body-md text-on-surface">2026. augusztus 10–14.</span>
        </li>
        <li
          class="bg-surface-container-lowest shadow-ambient flex items-center gap-2 rounded-full px-4 py-2"
        >
          <Icon name="ph:map-pin" class="text-primary size-5" />
          <span class="body-md text-on-surface">Krasznai Falumúzeum</span>
        </li>
      </ul>

      <button
        type="button"
        class="gallery-trigger group focus-visible:ring-primary relative mt-8 block w-full overflow-hidden rounded-xl focus-visible:ring-2 focus-visible:outline-none"
        data-gallery="camp-group-2026"
        data-index="0"
        aria-label="A tábor csoportképe teljes méretben"
      >
        <Image
          src={groupPhoto}
          alt="Kreatív Nyári Tábor 2026 – közös csoportkép a kézlenyomat-fával"
          widths={[600, 900, 1200, 1600]}
          sizes="(max-width: 1200px) 100vw, 1200px"
          class="shadow-ambient-md w-full"
        />
        <span
          class="absolute right-3 bottom-3 flex items-center gap-1.5 rounded-full bg-black/55 px-3 py-1.5 text-white opacity-0 backdrop-blur-sm transition group-hover:opacity-100"
        >
          <Icon name="ph:magnifying-glass-plus" class="size-4" />
          <span class="label-sm uppercase">Nagyítás</span>
        </span>
      </button>
    </div>
  </section>

  <!-- ============== Képgaléria – tematikus napok ============== -->
  <section class="bg-surface-container-low px-5 py-20 md:px-10 lg:px-20">
    <div class="mx-auto" style="max-width: var(--container-max);">
      <SectionTitle
        title="Képgaléria"
        subtitle={`Pillanatképek a tábor tematikus napjairól – összesen ${photoCount} kép.`}
      />

      <div class="mt-12 flex flex-col gap-8">
        {
          days.map((day) => {
            const images = dayGalleries[day.id] ?? [];
            const thumbs = images.slice(0, 6);
            const remaining = images.length - thumbs.length;
            return (
              <article class="bg-surface-container-lowest shadow-ambient rounded-lg p-6 md:p-10">
                <div class="flex items-start gap-4">
                  <div
                    class="bg-primary-fixed/50 flex size-14 flex-none items-center justify-center rounded-full"
                    aria-hidden="true"
                  >
                    <Icon name={day.icon} class="text-primary size-7" />
                  </div>
                  <div>
                    <p class="label-sm text-primary uppercase">{day.badge}</p>
                    <h3 class="title-sm md:title-lg text-on-surface mt-1">{day.title}</h3>
                    <dl class="mt-2 flex flex-wrap items-center gap-x-6 gap-y-1">
                      <div class="flex items-center gap-2">
                        <Icon name="ph:calendar-blank" class="text-primary size-5 flex-none" />
                        <dd class="body-md text-on-surface">{day.date}</dd>
                      </div>
                      <div class="flex items-center gap-2">
                        <Icon name="ph:images" class="text-primary size-5 flex-none" />
                        <dd class="body-md text-on-surface">{images.length} kép</dd>
                      </div>
                    </dl>
                  </div>
                </div>

                {images.length > 0 && (
                  <>
                    <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
                      {thumbs.map((img, i) => (
                        <li>
                          <button
                            type="button"
                            class="gallery-trigger group focus-visible:ring-primary relative block w-full overflow-hidden rounded-lg focus-visible:ring-2 focus-visible:outline-none"
                            data-gallery={day.id}
                            data-index={i}
                            aria-label={`${day.title} – galéria megnyitása`}
                          >
                            <Image
                              src={img}
                              alt={`${day.title} – ${i + 1}. kép`}
                              widths={[300, 450, 600]}
                              sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 340px"
                              class="aspect-square w-full object-cover transition group-hover:scale-105"
                            />
                            {i === thumbs.length - 1 && remaining > 0 && (
                              <span class="absolute inset-0 flex items-center justify-center bg-black/55 transition group-hover:bg-black/65">
                                <span class="title-sm text-white">+{remaining}</span>
                              </span>
                            )}
                          </button>
                        </li>
                      ))}
                    </ul>
                    <button
                      type="button"
                      class="gallery-trigger text-primary hover:text-primary-container mt-4 inline-flex items-center gap-2 rounded-full"
                      data-gallery={day.id}
                      data-index="0"
                    >
                      <Icon name="ph:images" class="size-5" />
                      <span class="label-sm uppercase">
                        Galéria megnyitása ({images.length} kép)
                      </span>
                    </button>
                  </>
                )}
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Gallery data for the shared lightbox (id -> [{ src, thumb, alt }]) -->
  <script type="application/json" id="galleries-data" set:html={JSON.stringify(galleryData)} />

  <GalleryLightbox />
</Layout>
