---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout
  active="programs"
  programsSub="camp"
  title="GrowKids Future — Tábor 2026"
  description="A 2026-os GrowKids Future tábor részletei hamarosan elérhetők lesznek."
>
  <!-- ============== Hero ============== -->
  <section class="px-5 pt-10 pb-12 md:px-10 md:pt-14 md:pb-16 lg:px-20">
    <div class="mx-auto" style="max-width: var(--container-max);">
      <p class="label-sm text-primary uppercase">Programjaink</p>
      <h1 class="headline-lg-mobile md:headline-lg text-on-surface mt-3">Tábor 2026</h1>
      <p class="body-md text-on-surface-variant mt-5 max-w-2xl">
        A 2026-os táborunk részletei hamarosan elérhetők lesznek.
      </p>
    </div>
  </section>

  <!-- ============== Placeholder body (awaiting camp details) ============== -->
  <section class="px-5 pb-20 md:px-10 lg:px-20">
    <div class="mx-auto" style="max-width: var(--container-max);">
      <div
        class="bg-surface-container-low flex flex-col items-center rounded-lg px-6 py-16 text-center"
      >
        <div
          class="bg-primary-fixed/50 flex size-16 items-center justify-center rounded-full"
          aria-hidden="true"
        >
          <Icon name="ph:tent-duotone" class="text-primary size-8" />
        </div>
        <h2 class="title-lg text-on-surface mt-6">Hamarosan</h2>
        <p class="body-md text-on-surface-variant mt-3 max-w-md">
          A tábor programja, időpontja és jelentkezési feltételei kidolgozás alatt állnak. Hamarosan
          itt találod a részleteket.
        </p>
      </div>
    </div>
  </section>
</Layout>
