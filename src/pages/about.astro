---
import Layout from "../layouts/Layout.astro";
import Contacts from "../components/Contacts.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

const activities = [
  {
    title: "Családtervezési és meddőségi tájékoztatás",
    body: "Szakmai és emberközpontú információval segítjük a családalapítás útján elindulókat.",
    icon: "ph:hand-heart-duotone",
  },
  {
    title: "Erdélyi magyar lombikprogram támogatása",
    body: "Anyagi és közösségi támogatással segítjük a lombikprogramban részt vevő családokat.",
    icon: "ph:test-tube-duotone",
  },
  {
    title: "Korai fejlesztés",
    body: "A legkisebbek fejlődésének támogatása szakemberek segítségével, hogy minden gyermek a legjobb eséllyel indulhasson az életben.",
    icon: "ph:users-three-duotone",
  },
  {
    title: "Terápiás és egyéb fejlesztő lehetőségek",
    body: "Széles körű terápiás és fejlesztő támogatás biztosítása gyermekek számára, egyéni szükségleteikhez igazodva.",
    icon: "ph:puzzle-piece-duotone",
  },
  {
    title: "Lelki és közösségi támogatás",
    body: "Figyelünk a lelki jóllétre is, mert tudjuk, hogy a támogatás a gyógyulás fontos része.",
    icon: "ph:heart-duotone",
  },
];
---

<Layout
  active="about"
  title="GrowKids Future — Rólunk"
  description="A GrowKids Future egyesület egy fiatal kezdeményezés a családalapítás támogatására, a gyermekvállalás segítésére és a jövő generációinak támogatására."
>
  <!-- ============== Hero ============== -->
  <section class="px-5 pt-10 pb-16 md:px-10 md:pt-14 md:pb-20 lg:px-20 lg:pb-24">
    <div
      class="mx-auto grid items-center gap-10 md:gap-12 lg:grid-cols-2 lg:gap-16"
      style="max-width: var(--container-max);"
    >
      <div class="relative z-10 text-center lg:text-left">
        <h1 class="headline-lg-mobile md:headline-lg text-on-surface">Rólunk</h1>

        <p class="body-md text-on-surface-variant mt-6">
          A <span class="text-primary">GrowKids Future Egyesület</span> elkötelezett amellett, hogy támogassa
          a családalapítás, a gyermekvállalás és a gyermeknevelés legfontosabb szakaszait. Küldetésünk,
          hogy segítséget nyújtsunk a leendő szülőknek, támogassuk a meddőséggel küzdő párokat, valamint
          hozzájáruljunk a gyermekek
          <span class="text-primary">egészséges testi, lelki és szellemi fejlődéséhez</span> egy biztonságos,
          támogató közösség megteremtésével.
        </p>
        <p class="body-md text-on-surface-variant mt-4">
          Egyesületünk kiemelt figyelmet fordít a lombikprogramban (IVF) részt vevő családok
          támogatására. Célunk, hogy hiteles információkkal, közösségi összefogással, érzékenyítő
          kampányokkal, valamint lehetőségeinkhez mérten anyagi és erkölcsi segítséggel járuljunk
          hozzá ahhoz, hogy minél több pár megvalósíthassa álmát, és szülővé válhasson.
        </p>
        <p class="body-md text-on-surface-variant mt-4">
          A családalapítás támogatása mellett különböző oktatási, fejlesztő és közösségi programokat
          szervezünk gyermekek és családok számára. Tevékenységeink célja az önbizalom erősítése, a
          kreativitás kibontakoztatása, a készségek fejlesztése, valamint a közösségi értékek és az
          egymás iránti felelősségvállalás erősítése. Hiszünk abban, hogy minden gyermek megérdemli
          a lehetőséget arra, hogy tehetségét kibontakoztassa, és magabiztosan építse jövőjét.
        </p>
        <p class="body-md text-on-surface-variant mt-4">
          A GrowKids Future Egyesület munkájának alapja az
          <span class="text-primary">empátia, az összefogás és a társadalmi felelősségvállalás</span
          >. Célunk, hogy hidat építsünk a családok, a szakemberek és a közösség között, miközben
          támogatjuk az élet kezdetét és a gyermekek jövőjének építését.
        </p>
      </div>

      <div class="order-first lg:order-none">
        <div class="mx-auto max-w-[14rem] sm:max-w-xs md:max-w-sm">
          <Image
            src={logo}
            alt="GrowKids Future — két gyermek profilja egy növényből kibontakozva"
            width={419}
            height={512}
            class="h-auto w-full object-contain"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============== Activities ============== -->
  <section class="bg-surface-container-low px-5 py-20 md:px-10 lg:px-20">
    <div class="mx-auto" style="max-width: var(--container-max);">
      <SectionTitle title="Tevékenységeink" />

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          activities.map((a) => (
            <article class="bg-surface-container-lowest shadow-ambient flex flex-col items-center rounded-lg p-6 text-center">
              <div
                class="bg-primary-fixed/50 flex size-16 items-center justify-center rounded-full"
                aria-hidden="true"
              >
                <Icon name={a.icon} class="text-primary size-8" />
              </div>
              <h3 class="title-sm text-on-surface mt-5">{a.title}</h3>
              <p class="body-md text-on-surface-variant mt-3">{a.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============== Mission pull quote ============== -->
  <section class="px-5 py-20 md:px-10 lg:px-20">
    <div class="mx-auto" style="max-width: var(--container-max);">
      <SectionTitle title="Küldetésünk" />

      <blockquote
        class="bg-primary-fixed/40 mt-10 rounded-xl px-6 py-12 text-center md:px-16 md:py-14"
      >
        <p class="quote-lg md:quote-xl text-on-surface leading-snug">
          „A kezdeteket támogatjuk, a jövőt neveljük.”
        </p>
      </blockquote>
    </div>
  </section>

  <!-- ============== Contacts ============== -->
  <Contacts />
</Layout>
