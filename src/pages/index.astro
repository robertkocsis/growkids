---
import Layout from "../layouts/Layout.astro";
import Contacts from "../components/Contacts.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { url } from "../utils/url";
import embryosLogo from "../assets/supporters/embryos.png";
import ideaLogo from "../assets/supporters/idea.png";
import tronteremLogo from "../assets/supporters/tronterem.png";
import olecomLogo from "../assets/supporters/olecom.png";

const partners = [
  {
    name: "Embryos",
    logo: embryosLogo,
    maxH: "max-h-20",
    href: "https://embryos.ro/",
  },
  {
    name: "IDEA Könyvtár",
    logo: ideaLogo,
    maxH: "max-h-24",
    href: "https://ideakonyvter.ro/",
  },
  {
    name: "Mobila Király",
    logo: tronteremLogo,
    maxH: "max-h-20",
    href: "https://www.mobilakiraly.ro/",
  },
  {
    name: "OLECOM",
    logo: olecomLogo,
    maxH: "max-h-20",
    href: "https://www.olecom.ro/",
  },
];
---

<Layout active="home" title="GrowKids Future — Kezdőlap">
  <!-- HERO -->
  <section class="relative">
    <div
      class="mx-auto grid items-center gap-10 px-5 pt-6 pb-16 md:gap-12 md:px-10 md:pt-10 md:pb-20 lg:grid-cols-2 lg:gap-16 lg:px-20 lg:pb-28"
      style="max-width: var(--container-max);"
    >
      <div class="relative z-10 text-center lg:text-left">
        <h1 class="headline-lg-mobile lg:headline-xl text-on-surface">
          A kezdeteket<br />
          <span class="text-primary">támogatjuk,</span><br />
          a jövőt neveljük.
        </h1>
        <div class="mt-8 flex justify-center lg:justify-start">
          <a
            href={url("/about")}
            class="label-sm border-primary text-primary hover:bg-primary-fixed/40 inline-flex items-center justify-center rounded-full border px-6 py-3 uppercase transition"
          >
            Ismerj meg minket
          </a>
        </div>
      </div>

      <div class="relative order-first lg:order-none">
        <div class="mx-auto max-w-[16rem] sm:max-w-xs md:max-w-sm lg:max-w-md">
          <Image
            src={logo}
            alt="GrowKids Future — két gyermek profilja egy növényből kibontakozva"
            width={419}
            height={512}
            class="h-auto w-full object-contain"
            loading="eager"
          />
          <p
            lang="en"
            class="font-newsreader text-primary mt-2 text-center text-lg font-semibold italic md:mt-3 md:text-xl lg:text-2xl"
          >
            Supporting begins, growing the future
          </p>
        </div>
      </div>
    </div>

    <svg
      viewBox="0 0 1440 80"
      class="text-tertiary-fixed block w-full"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        fill="currentColor"
        opacity="0.7"
        d="M0 40c180 30 360 30 540 10s360-50 540-30 360 30 540 30 360 0 360 0V80H0z"></path>
      <path fill="currentColor" opacity="0.4" d="M0 50c240-20 480 20 720 20s480-40 720-30v40H0z"
      ></path>
    </svg>
  </section>

  <!-- CONTACTS -->
  <Contacts />

  <!-- PARTNERS -->
  <section class="px-5 py-20 md:px-10 lg:px-20">
    <SectionTitle title="Támogatók / Partnerek" />

    <div
      class="mx-auto mt-12 grid grid-cols-2 items-center gap-8 md:grid-cols-4"
      style="max-width: var(--container-max);"
    >
      {
        partners.map((p) => (
          <a
            href={p.href}
            rel="noopener noreferrer"
            target="_blank"
            aria-label={`${p.name} — partner weboldal (új lapon nyílik)`}
            class="group bg-surface-container-lowest shadow-ambient hover:shadow-ambient-md flex h-24 w-full items-center justify-center overflow-hidden rounded-md px-4 transition hover:-translate-y-0.5"
          >
            <Image
              src={p.logo}
              alt={`${p.name} logó`}
              class:list={[
                p.maxH,
                "w-auto max-w-full object-contain transition-opacity group-hover:opacity-80",
              ]}
            />
          </a>
        ))
      }
    </div>
  </section>
</Layout>
