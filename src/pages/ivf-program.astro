// single-page URL working and sends it to the default sub-page.
import { url } from "../utils/url";

const target = url("/ivf-program/supporting-beginnings");
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
