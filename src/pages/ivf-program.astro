---
import Layout from "../layouts/Layout.astro";
import Contacts from "../components/Contacts.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import callaLogo from "../assets/supporters/calla.png";
import heroImage from "../assets/ivf-hands.jpeg";

// Facebook group for the new "Erdélyi Termékenységi és Lombikprogram Közösség".
const communityGroup = "https://www.facebook.com/groups/1569573524898807";

// What members find in the community (feature-card grid).
const communityBenefits = [
  {
    icon: "ph:seal-check-duotone",
    title: "Megbízható információk",
    body: "Hiteles tudnivalók a meddőségről és a termékenységi kezelésekről.",
  },
  {
    icon: "ph:chalkboard-teacher-duotone",
    title: "Szakértői válaszok",
    body: "Szakemberek hasznos tanácsai és válaszai a felmerülő kérdésekre.",
  },
  {
    icon: "ph:chats-circle-duotone",
    title: "Sorstársak tapasztalatai",
    body: "Valódi történetek és megélt tapasztalatok azoktól, akik hasonló úton járnak.",
  },
  {
    icon: "ph:hand-heart-duotone",
    title: "Elfogadó közösség",
    body: "Támogatás, megértés és bátorítás egy biztonságos, elfogadó környezetben.",
  },
];

const values = [
  {
    title: "Támogatás és esély",
    body: "Lehetőséget biztosítunk azoknak a családoknak, akik számára a lombikprogram anyagi terhei leküzdhetetlenek.",
    icon: "hands",
  },
  {
    title: "Együtt a kezdetekért",
    body: "Minden támogatott család számára teljes körű orvosi ellátást és emberi odafigyelést biztosítunk.",
    icon: "heart",
  },
  {
    title: "A jövőért",
    body: "Hiszünk abban, hogy minden új élet egy reménnyel teli jövő kezdete – közösen építjük a holnapot.",
    icon: "sprout",
  },
  {
    title: "Közösség ereje",
    body: "Közösségünk támogatásával, összefogásával és együttérzésével teremtünk valódi változást.",
    icon: "people",
  },
];
---

<Layout
  active="ivf"
  title="GrowKids Future — Kezdeteket Támogatjuk Lombikprogram"
  description="A Kezdeteket Támogatjuk Lombikprogram az erdélyi magyar családoknak nyújt segítséget a gyermekáldás útján."
>
  <!-- ============== Hero ============== -->
  <section class="px-5 pt-10 pb-16 md:px-10 md:pt-14 md:pb-20 lg:px-20 lg:pb-28">
    <div
      class="mx-auto grid items-center gap-10 md:gap-12 lg:grid-cols-2 lg:gap-16"
      style="max-width: var(--container-max);"
    >
      <div class="relative z-10 text-center lg:text-left">
        <h1 class="headline-lg-mobile md:headline-lg">
          <span class="text-on-surface block">Kezdeteket Támogatjuk</span>
          <span class="text-primary mt-1 block">Lombikprogram</span>
        </h1>

        <p class="body-md text-on-surface-variant mt-6">
          Programunk célja, hogy segítséget nyújtsunk azoknak a
          <span class="text-primary">magyar családoknak Erdélyben</span>, akik gyermekáldásra
          vágynak, és orvosi támogatásra van szükségük ahhoz, hogy ez valóra válhasson.
        </p>
        <p class="body-md text-on-surface-variant mt-4">
          Partneri együttműködésben kiemelkedő szakmai színvonalon dolgozó klinikákkal biztosítjuk a
          lombikprogramokhoz való hozzáférést és a szükséges támogatást.
        </p>

        <div class="mt-8 flex justify-center lg:justify-start">
          <a
            href="#kapcsolat"
            class="label-sm border-primary text-primary hover:bg-primary-fixed/40 inline-flex items-center justify-center rounded-full border px-6 py-3 uppercase transition"
          >
            Lépj kapcsolatba
          </a>
        </div>
      </div>

      <div class="order-first lg:order-none">
        <Image
          src={heroImage}
          alt="Hagyományos népviseletbe öltözött pár közösen tart egy földlabdát, amelyből kis virág sarjad — a kezdetek és az új élet jelképe."
          widths={[400, 600, 800, 1000]}
          sizes="(max-width: 1024px) 90vw, 560px"
          class="shadow-ambient-md mx-auto h-auto w-full max-w-md rounded-xl object-cover lg:max-w-none"
        />
      </div>
    </div>
  </section>

  <!-- ============== Partner spotlight ============== -->
  <section class="px-5 py-12 md:px-10 lg:px-20">
    <div class="mx-auto" style="max-width: var(--container-max);">
      <div
        class="bg-surface-container-low grid items-stretch gap-10 rounded-xl p-8 md:grid-cols-[1fr_1px_1fr] md:gap-x-12 md:gap-y-0 md:p-12"
      >
        <div
          class="flex flex-col items-center justify-center gap-6 text-center md:items-start md:text-left"
        >
          <h2 class="title-lg text-on-surface">Kiemelt támogató partnerünk</h2>
          <a
            href="https://calla.ro/"
            rel="noopener noreferrer"
            target="_blank"
            class="inline-block transition-opacity hover:opacity-80"
            aria-label="Calla — Clinică de fertilitate & ginecologie"
          >
            <Image
              src={callaLogo}
              alt="Calla — Clinică de fertilitate & ginecologie"
              widths={[280, 360, 480]}
              sizes="(max-width: 768px) 280px, 360px"
              class="h-auto w-72 object-contain md:w-80"
            />
          </a>
        </div>

        <div class="bg-outline-variant hidden md:block" aria-hidden="true"></div>

        <div
          class="flex flex-col items-center gap-6 text-center md:flex-row md:items-center md:text-left"
        >
          <div
            class="bg-primary-fixed/60 flex size-16 flex-none items-center justify-center rounded-full"
            aria-hidden="true"
          >
            <Icon name="ph:hand-heart-duotone" class="text-primary size-8" />
          </div>

          <div>
            <p class="title-md text-on-surface">A Klinika évente</p>
            <p class="display-md md:display-lg text-primary mt-1">1 magyar családot</p>
            <p class="title-md text-on-surface mt-1">támogat lombikprogramban.</p>
            <p class="body-md text-on-surface-variant mt-5">
              Ez az együttműködés reményt és lehetőséget jelent azoknak a pároknak, akik a
              gyermekáldás útján járnak.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== New community — Erdélyi Termékenységi és Lombikprogram Közösség ============== -->
  <section class="bg-surface-container-low px-5 py-16 md:px-10 md:py-20 lg:px-20">
    <div class="mx-auto" style="max-width: var(--container-max);">
      <SectionTitle
        title="Elindult az Erdélyi Termékenységi és Lombikprogram Közösség!"
        subtitle="A GrowKids Future Egyesület örömmel mutatja be új közösségét, amely a nagyváradi Calla Központtal (az Embryos hálózat tagja) együttműködésében jött létre."
      />

      <p class="body-md text-on-surface-variant mx-auto mt-6 max-w-2xl text-center">
        Hiszünk abban, hogy a meddőséggel küzdő pároknak nemcsak korszerű orvosi ellátásra, hanem
        egy támogató, elfogadó közösségre is szükségük van. Ezért hoztuk létre ezt a csoportot, ahol
        biztonságos környezetben, hiteles információkhoz és valódi támogatáshoz juthattok.
      </p>

      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          communityBenefits.map((b) => (
            <li class="bg-surface-container-lowest shadow-ambient flex flex-col items-center rounded-lg p-6 text-center">
              <div
                class="bg-primary-fixed/50 flex size-16 items-center justify-center rounded-full"
                aria-hidden="true"
              >
                <Icon name={b.icon} class="text-primary size-8" />
              </div>
              <h3 class="title-sm text-on-surface mt-5">{b.title}</h3>
              <p class="body-md text-on-surface-variant mt-2">{b.body}</p>
            </li>
          ))
        }
      </ul>

      <div
        class="bg-surface-container-lowest shadow-ambient mx-auto mt-12 max-w-3xl rounded-xl px-6 py-10 text-center md:px-12 md:py-12"
      >
        <div
          class="bg-primary-fixed/60 mx-auto flex size-14 items-center justify-center rounded-full"
          aria-hidden="true"
        >
          <Icon name="ph:hand-heart-duotone" class="text-primary size-7" />
        </div>
        <p class="quote-lg text-on-surface mt-6">
          „Nem vagy egyedül. Együtt könnyebb végigmenni ezen az úton, és együtt erősebbé tehetjük a
          reményt.”
        </p>
        <p class="body-md text-on-surface-variant mt-5">
          Ha érintett vagy, vagy ismersz valakit, akinek segítséget jelenthet egy ilyen közösség,
          szeretettel várunk!
        </p>
        <a
          href={communityGroup}
          rel="noopener noreferrer"
          target="_blank"
          class="bg-primary text-on-primary hover:bg-primary-container hover:text-on-primary-container mt-8 inline-flex items-center gap-2 rounded-full px-6 py-3 transition"
        >
          <Icon name="ph:facebook-logo-fill" class="size-5" />
          <span class="label-sm uppercase">Csatlakozom a közösséghez</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============== Values / program goals ============== -->
  <section class="px-5 py-16 md:px-10 md:py-20 lg:px-20">
    <div class="mx-auto" style="max-width: var(--container-max);">
      <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v) => (
            <article class="flex flex-col items-center text-center">
              <div
                class="bg-primary-fixed/50 flex size-16 items-center justify-center rounded-full"
                aria-hidden="true"
              >
                {v.icon === "hands" && (
                  <Icon name="ph:hands-clapping-duotone" class="text-primary size-8" />
                )}
                {v.icon === "heart" && <Icon name="ph:heart-duotone" class="text-primary size-8" />}
                {v.icon === "sprout" && (
                  <Icon name="ph:plant-duotone" class="text-primary size-8" />
                )}
                {v.icon === "people" && (
                  <Icon name="ph:users-three-duotone" class="text-primary size-8" />
                )}
              </div>
              <h3 class="title-sm text-on-surface mt-6">{v.title}</h3>
              <p class="body-md text-on-surface-variant mt-3">{v.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============== Pull quote band ============== -->
  <section class="px-5 md:px-10 lg:px-20">
    <div class="mx-auto" style="max-width: var(--container-max);">
      <blockquote class="bg-primary-fixed/40 rounded-xl px-6 py-10 text-center md:px-16 md:py-12">
        <p class="quote-lg md:quote-xl text-on-surface">
          „A kezdeteket támogatjuk, a jövőt neveljük.”
        </p>
      </blockquote>
    </div>
  </section>

  <!-- ============== Contact strip ============== -->
  <Contacts id="kapcsolat" />
</Layout>
